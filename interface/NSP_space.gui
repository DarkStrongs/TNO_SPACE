			iconType = { name = "NSP_lsite_0" position = { x = 155 y = 94 } spriteType = "GFX_NSP_lsite_marker" frame = 1 pdx_tooltip = "NSP_LSITE_TT_0" pdx_tooltip_delayed = "NSP_LSITE_TT_0_D" }
			iconType = { name = "NSP_lsite_1" position = { x = 101 y = 85 } spriteType = "GFX_NSP_lsite_marker" frame = 1 pdx_tooltip = "NSP_LSITE_TT_1" pdx_tooltip_delayed = "NSP_LSITE_TT_1_D" }
