	#########################################################################
	# 1c. 规划器内容页（独立容器，scripted_gui NSP_planner 挂回外壳）
	#   与主页同位置同尺寸；visible = planner_open。返回按钮清 flag 即切回主页。
	#########################################################################
	containerWindowType = {
		name = "NSP_planner_body"
		position = { x = 12 y = 16 }
		size = { width = 1075 height = 690 }
		clipping = no   # 标题 y=-16 探出页面上沿，独立窗默认会裁
		background = {
			name = "Background"
			quadTextureSprite = "GFX_NSP_window_frame"
			# ⚠ 同上（AR DS_frame_inner 同款）：不吃鼠标事件，拖拽交给外层 Background
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "NSP_planner_title"
			position = { x = 287 y = -16 }
			# vt323_72_WT_outline = TNO「全球冲突」顶栏同款字体；fixedsize + 48 高
