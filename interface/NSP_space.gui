# 字体：只用 TNO 主字体族 aldrich_*_outline（TNOAR DS 面板同款；原版 hoi_* 在 TNO 下会渲染成色块）
#############################################################################
#  NSP — National Space Program / New Mission Concept
#  依赖：interface/NSP_space.gfx（贴图包）
#  两个窗口共用 1075x690 的主体尺寸，顶部 26px 是 Global Conflicts / Space 页签
#############################################################################

guiTypes = {

	#########################################################################
	# NSP 专用竖向滚动条（结构照抄原版 core.gui 的 right_vertical_slider）
	#   原版 position x = -5 → 滚动条占容器右侧 23px，压住 226 宽的卡片。
	#   这里 x = 0 贴右边，宽 18。必须写在文件最前面，先注册再被引用。
	#########################################################################
	extendedScrollbarType = {
		name = "NSP_right_slider"
		position = { x = 0 y = 0 }
		size = { width = 18 height = 18 }
		startValue = 0
		orientation = upper_right
		origo = upper_right
		smooth_scrolling = 0.25
		background = { name = "Background" quadTextureSprite = "GFX_scrollbar_vertical_bg" }
		slider = { name = "Slider" quadTextureSprite = "GFX_scroll_drager" position = { x = -2 y = -2 } }
		track = { name = "Track" quadTextureSprite = "GFX_scroll_track" position = { x = 3 y = 0 } alwaystransparent = yes }
		decreaseButton = { name = "Decrease" quadTextureSprite = "GFX_scroll_up" position = { x = 2 y = 3 } }
		increaseButton = { name = "Increase" quadTextureSprite = "GFX_scroll_down" position = { x = -17 y = -19 } }
	}

	# 隐形竖向滚动条：只为让滚轮能滚，不画、不占鼠标（修正列表太窄，放不下 18 宽的滚动条）
	extendedScrollbarType = {
		name = "NSP_hidden_slider"
		position = { x = 0 y = 0 }
		size = { width = 1 height = 18 }
		startValue = 0
		orientation = upper_right
		origo = upper_right
		smooth_scrolling = 0.25
		background = { name = "Background" quadTextureSprite = "GFX_NSP_scroll_clear" alwaystransparent = yes }
		slider = { name = "Slider" quadTextureSprite = "GFX_NSP_scroll_clear" alwaystransparent = yes }
		track = { name = "Track" quadTextureSprite = "GFX_NSP_scroll_clear" alwaystransparent = yes }
		decreaseButton = { name = "Decrease" quadTextureSprite = "GFX_NSP_scroll_clear" alwaystransparent = yes }
		increaseButton = { name = "Increase" quadTextureSprite = "GFX_NSP_scroll_clear" alwaystransparent = yes }
	}

	#########################################################################
	# 0. 顶栏开关
	#########################################################################
	containerWindowType = {
		name = "NSP_topbar_window"
		# ⭐ 2026-10-21 入口改成 TNOAR DS_topbar_window 同款：
		#   右下角 95x95 容器 + 九宫格金属外框（原版 core.gfx 的 GFX_tiled_window_thin_border2）
		#   + 居中图标按钮。
		# ⚠ 位置：主 mod 入口在 x=-83，AR 入口在 x=-178 → NSP 放【再左一格】x=-273，
		#   三者各差 95（＝窗宽）并排不重叠。想紧贴就把 x 往 0 调（-178 / -83）。
		size = { width = 95 height = 95 }
		position = { x = -273 y = -379 }
		orientation = lower_right
		# ⚠ 容器默认裁剪会切掉探出框外的元素（AR 同款理由）
		clipping = no
		background = {
			name = "NSP_entry_bg"
			quadTextureSprite = "GFX_tiled_window_thin_border2"
		}
		buttonType = {
			name = "NSP_topbar_button"
			position = { x = 48 y = 48 }
			centerposition = yes
			# 原图 24x24 像素图标 → 2 倍整数放大到 48x48（不拉伸变形、也不会像放 64 那样糊）
			size = { x = 48 y = 48 }
			spriteType = "GFX_NSP_station_marker"
			clicksound = click_default
			pdx_tooltip = "NSP_TOPBAR_TT"
		}
	}

	#########################################################################
	# 1. 主界面 NATIONAL SPACE PROGRAM
	#########################################################################
	containerWindowType = {
		name = "NSP_home_window"
		# ⭐ 2026-10-21 加【最外层】：照 TNOAR DS_main_window 的两层结构
		#   外层 = 整圈九宫格窗框 + 滑入动画 + 拖拽把手（有 background，吃鼠标事件）
		#   内层 = NSP_home_body（位置 12,26，尺寸不变 → 内部 600+ 元素坐标零改动）
		#   尺寸 1099x718 = 内框 1075x690 + 左右各 12 / 上 16（页签牌身压 7px + 9px 空隙，AR 同款）/ 下 12
		# ⚠ 滑入动画（巴西 TNO_CSS_BRA_map_GUI 同款）：position = 关闭位（屏幕上方外），
		#   show_position = 打开位（居中）。关→开位移固定 808px（AR 同款），别改位移量。
		#   打开减速滑下、关闭加速弹回。
		# ⭐ 滑入动画（巴西 TNO_CSS_BRA_map_GUI 同款）：position = 关闭位（屏幕上方外），
		#   show_position = 打开位（居中）；关→开位移固定 808px，改高度时只改这两处的 y。
		# ⚠ 切页时不叠影的关键不在动画，而在【主窗不隐藏】（见 NSP_open_planner 注释）：
		#   planner 从上方滑下盖住主窗，返回时弹回上方露出主窗 = 抽屉推入/拉出。
		position = { x = -550 y = -1167 }
		show_position = { x = -550 y = -359 }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 1000
		size = { width = 1099 height = 718 }
		orientation = center
		moveable = yes   # 用户要求外窗保持可拖
		# ⭐ 2026-10-21 本窗只是【外壳】（窗框背景 + 拖拽 + 滑入动画 + 页签）。
		#   两个内容页 NSP_home_body / NSP_planner_body 是独立容器，用 parent_window_name 挂到本窗，
		#   各自的 scripted_gui visible 决定显示哪页。⛔ 不要再把页面嵌套进本窗靠 _visible 切换：
		#   嵌套容器的 _visible 实机不生效（实机失败：规划器页常显且退不出）。
		# ⚠ 不写 fade_time/fade_type：淡出会抢在滑出动画前把窗口判定为隐藏
		#   → 「关闭不弹回」（AR DS_main_window 注释同款，巴西窗也只有位置动画没 fade）
		show_sound = decisions_ui_button
		hide_sound = click_close
		# ⚠ AR 同款：页签牌头要探出窗口上沿（y=-27），容器默认裁剪会切掉 → 显式关闭
		# （TNOAR DS_deep_state.gui 页签注释同款理由）
		clipping = no
		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_1b_no_border"
		}

		# ---- 全局页签（AR 同款巴西斜切角底牌，2026-10-21）----
		# 底牌 GFX_NSP_tab_bra：448x34 两帧（帧1 未选 / 帧2 选中），quadTextureSprite 自动取单帧 224x34。
		# ⚠ 必须用 quadTextureSprite（不能用 spriteType+size）：noOfFrames=2 的整图是 448 宽，
		#   普通 spriteType 引用会按整图取尺寸 → 按钮变 448 宽。
		# y=-27：牌高 34 → 牌头 27px 探在窗口上方、下沿 7px 压在窗口表面上（TNOAR DS_tab 同款几何）。
		# 间距 234 = 牌宽 224 + 10（AR DS_tab_1@12 / DS_tab_2@246 同款节奏）。
		buttonType = { name = "NSP_gtab_space"     position = { x = 12 y = -27 } quadTextureSprite = "GFX_NSP_tab_bra" frame = 2 buttonText = "NSP_GTAB_SPACE"     buttonFont = "Bomb_18" clicksound = click_default }
	}

	#########################################################################
	# 1b. 主页内容页（从 NSP_home_window 里拆出来的独立容器）
	#   scripted_gui NSP_home 用 parent_window_name = NSP_home_window 挂回外壳，
	#   坐标 (12,16) 相对外壳左上角；visible = home_open 且 NOT planner_open。
	#   背景 alwaystransparent → 鼠标落到外壳 Background → 整窗可拖。
	#########################################################################
	containerWindowType = {
		name = "NSP_home_body"
		position = { x = 12 y = 16 }
		size = { width = 1075 height = 690 }
		clipping = no   # 标题 y=-16 探出页面上沿，独立窗默认会裁
		background = {
			name = "Background"
			quadTextureSprite = "GFX_NSP_window_frame"
			# ⚠ 必须 alwaystransparent（AR DS_frame_inner 同款理由）：本容器铺满整窗，
			#   若它吃掉鼠标事件，外层窗口自己的 Background（拖拽把手）就拿不到按下/拖动
			#   → 窗口拖不动。只作用于本元素自身，容器内按钮/文本照常可点。
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "NSP_home_title"
			position = { x = 287 y = -16 }
			# vt323_72_WT_outline = TNO「全球冲突」顶栏同款字体；fixedsize + 48 高
			# 防止 72 号字顶出标题带（AR DS_title 同款套路）。
			font = "vt323_72_WT_outline"
			text = "NSP_TITLE_HOME"
			maxWidth = 500
			maxHeight = 48
			format = center
			fixedsize = yes
			alwaystransparent = yes
		}
		buttonType = { name = "NSP_info_button"  position = { x = 980 y = 12 }  spriteType = "GFX_NSP_button_info"  clicksound = click_default pdx_tooltip = "NSP_INFO_TT" }
		buttonType = { name = "NSP_close_button" position = { x = 1024 y = 12 } spriteType = "GFX_NSP_button_close" clicksound = click_close   pdx_tooltip = "NSP_CLOSE_TT" shortcut = "ESCAPE" }

		###################################################################
		# 1A. 左栏 Active Programs
