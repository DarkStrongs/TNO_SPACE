		###################################################################
		# 1C. 右栏 Mission Control
		###################################################################
		containerWindowType = {
			name = "NSP_mc_col"
			position = { x = 816 y = 70 }
			size = { width = 250 height = 470 }
			background = { name = "Background" quadTextureSprite = "GFX_NSP_panel_frame" }

			containerWindowType = { name = "NSP_mc_hdr" position = { x = 0 y = 0 } size = { width = 250 height = 26 } background = { name = "Background" quadTextureSprite = "GFX_NSP_panel_frame" }
				instantTextBoxType = { name = "NSP_mc_hdr_text" position = { x = 0 y = 4 } font = "aldrich_18_outline" text = "NSP_HDR_MC" maxWidth = 250 maxHeight = 20 format = center alwaystransparent = yes }
			}
			buttonType = { name = "NSP_mc_tab_0" position = { x = 1 y = 28 }   spriteType = "GFX_NSP_tab_mc2" frame = 2 buttonText = "NSP_MC_NATIONAL" buttonFont = "aldrich_16_outline" clicksound = click_default }
			buttonType = { name = "NSP_mc_tab_1" position = { x = 125 y = 28 } spriteType = "GFX_NSP_tab_mc2" frame = 1 buttonText = "NSP_MC_INTL"     buttonFont = "aldrich_16_outline" clicksound = click_default }

			# 原来 national / intl 两个滚动容器叠在同一位置——嵌套容器不能用 _visible 隐藏，
			#   两条滚动条都画出来，而且上层空的 intl 容器把鼠标滚轮吃掉了。
			#   现在合并成一个容器，两个 gridbox 都放在 y=0：recalc 只会填充当前页签对应的数组，另一个为空，不占位置。
			containerWindowType = {
				name = "NSP_mc_box"
				position = { x = 2 y = 62 }
				size = { width = 246 height = 402 }
				verticalScrollbar = "NSP_right_slider"
				background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
				margin = { top = 0 left = 0 bottom = 0 right = 0 }   # 滚动容器必须有 background
				scroll_wheel_factor = 40
				smooth_scrolling = yes
				# 不写 autohide_scrollbars：内容超出才出现滚动条
				gridBoxType = {
					name = "NSP_mc_national_grid"
					position = { x = 0 y = 0 }
					size = { width = 226 height = 100%% }   # 原版写法：高度随条目增长，滚动范围 = 实际内容
					slotsize = { width = 226 height = 122 }   # 任务卡 118 高 + 4 间距
					max_slots_horizontal = 1
					format = "UPPER_LEFT"
				}
				gridBoxType = {
					name = "NSP_mc_intl_grid"
					position = { x = 0 y = 0 }
					size = { width = 226 height = 100%% }
					slotsize = { width = 226 height = 122 }   # 任务卡 118 高 + 4 间距
					max_slots_horizontal = 1
					format = "UPPER_LEFT"
				}
			}
		}

