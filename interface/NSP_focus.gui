	containerWindowType = {
		name = "NSP_focus_in_window"
		# 298 → 310：内容容器 NSP_home_body 从 (0,26) 内缩到 (12,26)（外层九宫格框四周留 12px），
		# 地图左上角跟着右移 12px，聚焦动画窗挂在【外层 NSP_home_window】上，必须同步 +12。
		position = { x = 310 y = 96 }
		size = { width = 480 height = 270 }
		iconType = { name = "NSP_fin_frame" position = { x = 0 y = 0 } spriteType = "GFX_NSP_map_frame" alwaystransparent = yes }
		buttonType = { name = "NSP_focus_back" position = { x = 0 y = 0 } spriteType = "GFX_NSP_hit_map" pdx_tooltip = "NSP_TT_FOCUS" pdx_tooltip_delayed = "NSP_TT_FOCUS_D" clicksound = click_default }
		# 卫星计数 + 调试按钮（放在返回命中区之后 → 点得到；按钮只在 -debug 下显示）
		instantTextBoxType = { name = "NSP_sat_count" position = { x = 300 y = 10 } font = "aldrich_16_outline" text = "NSP_SAT_COUNT" maxWidth = 112 maxHeight = 16 format = right alwaystransparent = yes }
		# 卫星详情：每颗卫星一个小图标，悬停显示发射信息（卫星本身随 shader 运动，无法承载 tooltip）
		buttonType = { name = "NSP_sat_mk_0" position = { x = 452 y = 38 } spriteType = "GFX_NSP_sat_marker" clicksound = click_default pdx_tooltip = "NSP_SAT_TT_0" }
		iconType = { name = "NSP_sat_mks_0" position = { x = 452 y = 38 } spriteType = "GFX_NSP_sat_marker_sel" alwaystransparent = yes }
		buttonType = { name = "NSP_sat_mk_1" position = { x = 452 y = 59 } spriteType = "GFX_NSP_sat_marker" clicksound = click_default pdx_tooltip = "NSP_SAT_TT_1" }
