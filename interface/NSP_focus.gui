guiTypes = {
	# 位置 = NSP_home_body(0,26) + NSP_map_col(268,70) + 地图(30,10)；挪动地图时一起改
	# ==== 聚焦动画层（常驻窗口，只放 16 个动画按钮）====
	# ⭐ 时间轴 = Time - AnimationTime（按钮进入当前状态的时刻）。
	# 实测：AnimationTime 有效（调试角标全绿），但按钮状态从不变化 → 每颗行星只播第一次。
	#   窗口常驻，不再隐藏；按钮的 click_enabled 跟着 NSP_focus/NSP_fmode 切换。
	#   禁用 → 启用 = 一次状态切换 = 新的 AnimationTime。禁用态（Disable）在 shader 里输出全透明。
	#   ⚠ 本窗口必须声明在 in/out 窗口之前（期望画在它们下面，边框盖在动画上）
	containerWindowType = {
		name = "NSP_focus_fx_window"
		position = { x = 310 y = 96 }
		size = { width = 480 height = 270 }
		clipping = no
		buttonType = { name = "NSP_fin_mercury" position = { x = 0 y = 0 } spriteType = "GFX_NSP3D_focusbt_mercury" scale = 2 alwaystransparent = yes }
		buttonType = { name = "NSP_fin_venus" position = { x = 0 y = 0 } spriteType = "GFX_NSP3D_focusbt_venus" scale = 2 alwaystransparent = yes }
