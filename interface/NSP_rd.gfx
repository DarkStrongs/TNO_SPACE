# 研究与发展页贴图（work/rd/gen_rd.py 生成，勿手改）
# 全部是 TNO 像素风：硬边、少色、1px 墨线。半分辨率图（art / links / era）在 GUI 里 scale = 2（整数倍）。
spriteTypes = {
	spriteType = {
		name = "GFX_NSP_rd_card"
		texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_card.dds"
		noOfFrames = 4
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_NSP_rd_state"
		texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_state.dds"
		noOfFrames = 4
		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_NSP_rd_grid"
		texturefile = "gfx/interface/NSP/rd/tree/nsp_rd_grid.dds"
	}
