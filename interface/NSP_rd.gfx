		texturefile = "gfx/interface/NSP/rd/tree/nsp_rd_pad.dds"
	}
	spriteType = { name = "GFX_NSP_rdl_h"  texturefile = "gfx/interface/NSP/rd/links/nsp_rdl_h.dds"  noOfFrames = 17 legacy_lazy_load = no }
	spriteType = { name = "GFX_NSP_rdl_vu" texturefile = "gfx/interface/NSP/rd/links/nsp_rdl_vu.dds" noOfFrames = 17 legacy_lazy_load = no }
