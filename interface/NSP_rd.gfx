	spriteType = { name = "GFX_NSP_rdl_tail" texturefile = "gfx/interface/NSP/rd/links/nsp_rdl_tail.dds" noOfFrames = 5 legacy_lazy_load = no }
	# ⭐ r79 小科技方卡（只给加成、不解锁东西；照 TNO 小科技）：底框 / 线稿（tools/gen_rd_small.py）/ 选中框 / 进度条
	# ⭐ r80 TNO 科技边框（来源：TNO Antarctica_Decision_GUI_AAA_Technology_*，已改名）。帧 1 不可研发 / 2 可研发 / 3 研发中（静帧）/ 4 已研发
	spriteType = { name = "GFX_NSP_rd_frame_l" texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_frame_l.dds" noOfFrames = 4 legacy_lazy_load = no }
	spriteType = { name = "GFX_NSP_rd_frame_s" texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_frame_s.dds" noOfFrames = 4 legacy_lazy_load = no }
	# 研发中：循环动画（looping = yes 的 frameAnimated 一直播，不涉及 r31 那个"只播一次"的坑）
	frameAnimatedSpriteType = { name = "GFX_NSP_rd_frame_l_anim" texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_frame_l_anim.dds" noOfFrames = 8 animation_rate_fps = 8 looping = yes play_on_show = yes alwaystransparent = yes legacy_lazy_load = no }
	frameAnimatedSpriteType = { name = "GFX_NSP_rd_frame_s_anim" texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_frame_s_anim.dds" noOfFrames = 6 animation_rate_fps = 6 looping = yes play_on_show = yes alwaystransparent = yes legacy_lazy_load = no }
	spriteType = { name = "GFX_NSP_rd_scard" texturefile = "gfx/interface/NSP/rd/cards/nsp_rd_scard.dds" noOfFrames = 4 legacy_lazy_load = no }
